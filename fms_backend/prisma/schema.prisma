// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(cuid())
  username     String? @unique
  email        String? @unique
  passwordHash String?
  role         Role

  manager     Manager?
  driver      Driver?
  maintenance Maintenance?

  createdUsers    User[]        @relation("UserCreatedUsers")
  createdById     String?
  createdBy       User?         @relation("UserCreatedUsers", fields: [createdById], references: [id])
  createdVehicles Vehicle[]     @relation("UserCreatedVehicles")
  issueReports    IssueReport[] @relation("UserIssueReports")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Manager {
  id      String  @id @default(cuid())
  name    String
  phone   String? @unique
  address String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Driver {
  id              String   @id @default(cuid())
  name            String
  phone           String   @unique
  email           String   @unique
  licenceNumber   String   @unique
  expiryDate      String
  classes         String[]
  status          Status
  dlFrontImageUrl String?
  dlBackImageUrl  String?
  dlFrontImageKey String?
  dlBackImageKey  String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Maintenance {
  id    String   @id @default(cuid())
  name  String
  dob   DateTime
  phone String   @unique
  email String   @unique

  workOrder WorkOrder[]

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkOrder {
  id          String @id @default(cuid())
  vehicleName String
  title       String

  priority Priority

  date           DateTime
  taskDetails    String
  workOrderMedia String[]

  maintenanceId String
  maintenance   Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id                 String        @id @default(cuid())
  make               String
  model              String
  type               String
  status             VehicleStatus @default(AVAILABLE)
  imageName          String?
  year               String?
  color              String?
  operationalStatus  String?       @default("OPERATIONAL")
  assessmentReason   String?
  chassisNumber      String        @unique @map("chassis_num")
  registrationNumber String        @unique @map("registration_num")

  rcImageUrl      String?
  vehicleImageUrl String?
  rcImageKey      String?
  vehicleImageKey String?

  assignedDriverId String? @unique

  createdById String?
  createdBy   User?   @relation("UserCreatedVehicles", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicles")
}

model VehicleTrip {
  id        String @id @default(cuid())
  vehicleId String @unique

  origin       String
  destination  String
  progress     Float
  eta          String?
  date         String?
  distance     String?
  duration     String?
  costEstimate String?
  startTime    DateTime?
  status       TripStatus @default(PENDING)
  productType  String?
  loadAmount   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_trips")
}

model VehicleMaintenance {
  id        String @id @default(cuid())
  vehicleId String @unique

  nextService      String?
  inspectionStatus String?
  alerts           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_maintenance")
}

model TripHistory {
  id        String @id @default(cuid())
  vehicleId String

  vehicleID    String
  origin       String
  destination  String
  progress     Float
  eta          String?
  date         String?
  distance     String?
  duration     String?
  costEstimate String?
  startTime    DateTime?
  status       TripStatus @default(PENDING)
  productType  String?
  loadAmount   String?

  createdAt DateTime @default(now())

  @@map("trip_history")
}

model Trips {
  id                  String @id @default(cuid())
  sourceLocation      String
  destinationLocation String
  productType         String
  unit                String
  amount              Int
  vehicle             String
  driver              String
  departureTime       String
  createdById         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IssueReport {
  id               String            @id @default(cuid())
  driverUserId     String
  tripId           String?
  transcript       String
  incidentLocation String
  vehicleUnit      String
  imageKeys        String[]
  status           IssueReportStatus @default(OPEN)

  driverUser User @relation("UserIssueReports", fields: [driverUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverUserId])
  @@map("issue_reports")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  DRIVER
  MAINTENANCE
}

enum Status {
  ACTIVE
  ON_TRIP
  OFF_DUTY
}

enum VehicleStatus {
  AVAILABLE
  IN_TRANSIT
  MAINTENANCE
}

enum TripStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum IssueReportStatus {
  OPEN
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}
