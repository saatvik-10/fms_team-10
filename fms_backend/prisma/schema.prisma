// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(cuid())
  username     String? @unique
  email        String? @unique
  passwordHash String?
  role         Role

  manager     Manager?
  driver      Driver?
  maintenance Maintenance?

  createdUsers    User[]        @relation("UserCreatedUsers")
  createdById     String?
  createdBy       User?         @relation("UserCreatedUsers", fields: [createdById], references: [id])
  createdVehicles Vehicle[]     @relation("UserCreatedVehicles")
  issueReports    IssueReport[] @relation("UserIssueReports")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Manager {
  id      String  @id @default(cuid())
  name    String
  phone   String? @unique
  address String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Driver {
  id              String   @id @default(cuid())
  name            String
  phone           String   @unique
  email           String   @unique
  licenceNumber   String   @unique
  expiryDate      String
  classes         String[]
  status          Status
  dlFrontImageUrl String?
  dlBackImageUrl  String?
  dlFrontImageKey String?
  dlBackImageKey  String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips     Trips[]
}

model Maintenance {
  id    String   @id @default(cuid())
  name  String
  dob   DateTime
  phone String   @unique
  email String   @unique

  workOrder WorkOrder[]

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkOrder {
  id          String @id @default(cuid())
  vehicleName String
  vehicleNum  String @default("UNKNOWN")
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  title       String
  serviceType String?

  priority Priority

  date           DateTime
  taskDetails    String
  workOrderMedia String[]

  maintenanceId String
  maintenance   Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  tripId        String?

  status        String @default("PROGRESS")
  totalCost     Float  @default(0)

  inspection    Inspection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inspection {
  id                 String   @id @default(cuid())
  workOrderId        String?  @unique
  workOrder          WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  title              String
  vehicleId          String
  unitName           String
  unitVIN            String
  driverId           String
  timestamp          DateTime
  type               String
  vehicleType        String
  status             String   @default("Pending")
  priority           String   @default("Medium")
  items              Json
  consumedParts      Json?
  notes              String?
  taskDetails        String?
  maintenanceStaffId String
  isEmergency        Boolean  @default(false)
  odometer           String
  fuelLevel          String
  imageUrls          String[]
  reportUrl          String?
  maintenanceId      String

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("inspections")
}

model Vehicle {
  id                 String        @id @default(cuid())
  make               String
  model              String
  type               String
  status             VehicleStatus @default(AVAILABLE)
  totalMaintenanceCost Float @default(0)
  imageName          String?
  year               String?
  color              String?
  operationalStatus  String?       @default("OPERATIONAL")
  assessmentReason   String?
  chassisNumber      String        @unique @map("chassis_num")
  registrationNumber String        @unique @map("registration_num")

  rcImageUrl      String?
  vehicleImageUrl String?
  rcImageKey      String?
  vehicleImageKey String?

  maxLoadCapacity  Float @default(0)
  capacityUnit       String @default("KG")

  assignedDriverId String? @unique

  createdById String?
  createdBy   User?   @relation("UserCreatedVehicles", fields: [createdById], references: [id])
  workOrders  WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips      Trips[]

  @@map("vehicles")
}

model VehicleTrip {
  id        String @id @default(cuid())
  vehicleId String @unique

  origin       String
  destination  String
  progress     Float
  eta          String?
  date         String?
  distance     String?
  duration     String?
  costEstimate String?
  startTime    DateTime?
  status       TripStatus @default(SCHEDULED)
  productType  String?
  loadAmount   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_trips")
}

model VehicleMaintenance {
  id        String @id @default(cuid())
  vehicleId String @unique

  nextService      String?
  inspectionStatus String?
  alerts           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_maintenance")
}

model TripHistory {
  id        String @id @default(cuid())
  vehicleId String

  vehicleID    String
  origin       String
  destination  String
  progress     Float
  eta          String?
  date         String?
  distance     String?
  duration     String?
  costEstimate String?
  startTime    DateTime?
  status       TripStatus @default(SCHEDULED)
  productType  String?
  loadAmount   String?

  createdAt DateTime @default(now())

  @@map("trip_history")
}

model Trips {
  id                  String @id @default(cuid())
  sourceLocation      String
  destinationLocation String
  productType         String
  unit                String
  amount              Int
  vehicleId           String?
  vehicle             Vehicle? @relation(fields: [vehicleId], references: [id])
  driverId            String?
  driver              Driver?  @relation(fields: [driverId], references: [id])
  departureTime       String
  createdById         String
  status              String  @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IssueReport {
  id               String            @id @default(cuid())
  driverUserId     String
  tripId           String?
  transcript       String
  incidentLocation String
  vehicleUnit      String
  imageKeys        String[]
  status           IssueReportStatus @default(OPEN)

  driverUser User @relation("UserIssueReports", fields: [driverUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverUserId])
  @@map("issue_reports")
}

model ChatRoom {
  id               String       @id @default(uuid())
  name             String
  avatarInitials   String?      @map("avatar_initials")
  roomType         ChatRoomType @default(GROUP) @map("room_type")
  participants     String[]
  participantNames Json?        @map("participant_names")
  lastActivity     DateTime     @default(now()) @map("last_activity")

  messages ChatMessage[]
  reads    ChatRoomRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chat_rooms")
}

model ChatMessage {
  id             String  @id @default(uuid())
  roomId         String  @map("room_id")
  senderId       String  @map("sender_id")
  senderName     String  @map("sender_name")
  senderRole     String  @map("sender_role")
  content        String
  status         String  @default("sent")
  isStarred      Boolean @default(false) @map("is_starred")
  attachmentType String? @map("attachment_type")
  attachmentUrl  String? @map("attachment_url")

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  timestamp DateTime @default(now())

  @@index([roomId])
  @@map("chat_messages")
}

model ChatRoomRead {
  id         String   @id @default(cuid())
  roomId     String   @map("room_id")
  userId     String   @map("user_id")
  lastReadAt DateTime @default(now()) @map("last_read_at")

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("chat_room_reads")
}

enum ChatRoomType {
  DIRECT
  GROUP
  BROADCAST
}

enum Role {
  SUPER_ADMIN
  MANAGER
  DRIVER
  MAINTENANCE
}

enum Status {
  ACTIVE
  ON_TRIP
  OFF_DUTY
}

enum VehicleStatus {
  AVAILABLE
  IN_TRANSIT
  MAINTENANCE
  SCHEDULED
}

enum TripStatus {
  CANCELLED
  PENDING
  SCHEDULED
  IN_TRANSIT
  COMPLETED
}

enum WorkOrderStatus {
  PROGRESS
  COMPLETED
}

enum IssueReportStatus {
  OPEN
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}
